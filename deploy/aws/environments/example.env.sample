# Copy to <env>.env (gitignored) in this directory. Sourced by scripts/aws/deploy.sh.
# INTERNAL_DOMAIN must match terraform var.domain_name; nginx resolves peer
# stacks as <stack>.$INTERNAL_DOMAIN.
export INTERNAL_DOMAIN=example.com
export BROKER_DESIRED_COUNT_APNE1=3
export BROKER_DESIRED_COUNT_APNE3=3
export NGINX_DESIRED_COUNT_APNE1=3
export NGINX_DESIRED_COUNT_APNE3=3
export RUNNER_DESIRED_COUNT_APNE1=300
export RUNNER_DESIRED_COUNT_APNE3=300
