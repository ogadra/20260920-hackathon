# Port the runner listens on.
RUNNER_API_PORT=3000

# Broker URL for runner registration. Required.
BROKER_URL=http://broker:8080

STACK_NAME=local

# Jev (TypeSafe System One) command validation. All three are required:
# the runner refuses to start without them.
# JEV_API_KEY is issued at https://console.typesafe.ai/.
JEV_API_KEY=
# JEV_MODEL selects the model. Pin a version to keep thresholds stable.
JEV_MODEL=jev-latest
# JEV_SAFE_THRESHOLD is the lowest safe probability that still executes.
JEV_SAFE_THRESHOLD=0.80
